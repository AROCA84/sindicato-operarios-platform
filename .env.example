# WhatsApp Cloud API
# Crea un valor largo y aleatorio. No lo publiques.
WHATSAPP_VERIFY_TOKEN=
# Token de acceso de Meta para el número de prueba o de producción. No lo publiques.
WHATSAPP_ACCESS_TOKEN=
# El identificador del número de teléfono de Meta (Phone Number ID), no tu número de WhatsApp.
WHATSAPP_PHONE_NUMBER_ID=
# Versión de Graph API usada por Meta.
WHATSAPP_GRAPH_API_VERSION=v25.0
